{
  "description": "noes conjunctions used through shouldValidate",
  "groups": [
    {
      "name": "and with equality and predicates",
      "rules": {
        "x": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "a": "yes",
                "n": {
                  ">": 5
                }
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "a": "yes",
            "n": 6
          },
          "expected": {
            "success": false,
            "messages": {
              "x": {
                "required": "X field is required."
              }
            }
          }
        },
        {
          "input": {
            "a": "yes",
            "n": "6"
          },
          "expected": {
            "success": false,
            "messages": {
              "x": {
                "required": "X field is required."
              }
            }
          }
        },
        {
          "input": {
            "a": "yes",
            "n": 5
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        },
        {
          "input": {
            "a": "no",
            "n": 6
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        },
        {
          "input": {},
          "expected": {
            "success": true,
            "messages": {}
          }
        },
        {
          "input": {
            "a": "yes",
            "n": "abc"
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        }
      ]
    },
    {
      "name": "or",
      "rules": {
        "x": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "or",
              "mappings": {
                "a": "yes",
                "b": "yes"
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "a": "yes"
          },
          "expected": {
            "success": false,
            "messages": {
              "x": {
                "required": "X field is required."
              }
            }
          }
        },
        {
          "input": {
            "b": "yes"
          },
          "expected": {
            "success": false,
            "messages": {
              "x": {
                "required": "X field is required."
              }
            }
          }
        },
        {
          "input": {
            "a": "no",
            "b": "no"
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        },
        {
          "input": {},
          "expected": {
            "success": true,
            "messages": {}
          }
        }
      ]
    },
    {
      "name": "all predicate aliases",
      "rules": {
        "gt": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "$greaterThan": 1
                }
              }
            }
          }
        ],
        "gte": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  ">=": 2
                }
              }
            }
          }
        ],
        "lt": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "<": 3
                }
              }
            }
          }
        ],
        "lte": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "$lessThanOrEqual": 2
                }
              }
            }
          }
        ],
        "eq": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "===": 2
                }
              }
            }
          }
        ],
        "eqAlias": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "$equal": 2
                }
              }
            }
          }
        ],
        "neq": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "!==": 2
                }
              }
            }
          }
        ],
        "neqAlias": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "$notEqual": 2
                }
              }
            }
          }
        ],
        "gtAlias": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "$greaterThanOrEqual": 2
                }
              }
            }
          }
        ],
        "ltAlias": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "$lessThan": 3
                }
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "n": 2
          },
          "expected": {
            "success": false,
            "messages": {
              "gt": {
                "required": "Gt field is required."
              },
              "gte": {
                "required": "Gte field is required."
              },
              "lt": {
                "required": "Lt field is required."
              },
              "lte": {
                "required": "Lte field is required."
              },
              "eq": {
                "required": "Eq field is required."
              },
              "eqAlias": {
                "required": "Eq Alias field is required."
              },
              "gtAlias": {
                "required": "Gt Alias field is required."
              },
              "ltAlias": {
                "required": "Lt Alias field is required."
              }
            }
          }
        },
        {
          "input": {
            "n": "2"
          },
          "expected": {
            "success": false,
            "messages": {
              "gt": {
                "required": "Gt field is required."
              },
              "gte": {
                "required": "Gte field is required."
              },
              "lt": {
                "required": "Lt field is required."
              },
              "lte": {
                "required": "Lte field is required."
              },
              "neq": {
                "required": "Neq field is required."
              },
              "neqAlias": {
                "required": "Neq Alias field is required."
              },
              "gtAlias": {
                "required": "Gt Alias field is required."
              },
              "ltAlias": {
                "required": "Lt Alias field is required."
              }
            }
          }
        },
        {
          "input": {},
          "expected": {
            "success": false,
            "messages": {
              "neq": {
                "required": "Neq field is required."
              },
              "neqAlias": {
                "required": "Neq Alias field is required."
              }
            }
          }
        }
      ]
    },
    {
      "name": "array of predicates in and is all, in or is any",
      "rules": {
        "andRange": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": [
                  {
                    ">": 1
                  },
                  {
                    "<": 5
                  }
                ]
              }
            }
          }
        ],
        "orValues": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "or",
              "mappings": {
                "n": [
                  1,
                  3,
                  {
                    ">": 10
                  }
                ]
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "n": 3
          },
          "expected": {
            "success": false,
            "messages": {
              "andRange": {
                "required": "And Range field is required."
              },
              "orValues": {
                "required": "Or Values field is required."
              }
            }
          }
        },
        {
          "input": {
            "n": 1
          },
          "expected": {
            "success": false,
            "messages": {
              "orValues": {
                "required": "Or Values field is required."
              }
            }
          }
        },
        {
          "input": {
            "n": 11
          },
          "expected": {
            "success": false,
            "messages": {
              "orValues": {
                "required": "Or Values field is required."
              }
            }
          }
        },
        {
          "input": {
            "n": 7
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        }
      ]
    },
    {
      "name": "nested conjunction",
      "rules": {
        "x": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "a": "yes",
                "sub": {
                  "type": "or",
                  "mappings": {
                    "b": 1,
                    "c": 1
                  }
                }
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "a": "yes",
            "b": 1
          },
          "expected": {
            "success": false,
            "messages": {
              "x": {
                "required": "X field is required."
              }
            }
          }
        },
        {
          "input": {
            "a": "yes",
            "c": 1
          },
          "expected": {
            "success": false,
            "messages": {
              "x": {
                "required": "X field is required."
              }
            }
          }
        },
        {
          "input": {
            "a": "yes"
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        },
        {
          "input": {
            "a": "no",
            "b": 1
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        }
      ]
    },
    {
      "name": "deep equality on objects and arrays",
      "rules": {
        "x": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "tags": {
                  "===": [
                    "a",
                    "b"
                  ]
                },
                "meta": {
                  "$equal": {
                    "k": 1
                  }
                }
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "tags": [
              "a",
              "b"
            ],
            "meta": {
              "k": 1
            }
          },
          "expected": {
            "success": false,
            "messages": {
              "x": {
                "required": "X field is required."
              }
            }
          }
        },
        {
          "input": {
            "tags": [
              "b",
              "a"
            ],
            "meta": {
              "k": 1
            }
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        },
        {
          "input": {
            "tags": [
              "a",
              "b"
            ],
            "meta": {
              "k": "1"
            }
          },
          "expected": {
            "success": true,
            "messages": {}
          }
        }
      ]
    },
    {
      "name": "empty mappings",
      "rules": {
        "and": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {}
            }
          }
        ],
        "or": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "or",
              "mappings": {}
            }
          }
        ]
      },
      "cases": [
        {
          "input": {},
          "expected": {
            "success": false,
            "messages": {
              "and": {
                "required": "And field is required."
              }
            }
          }
        }
      ]
    },
    {
      "name": "invalid predicate throws",
      "rules": {
        "x": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": {
                  "~": 1
                }
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "n": 1
          },
          "expectedError": "~ is not a valid predicate"
        }
      ]
    },
    {
      "name": "invalid type throws",
      "rules": {
        "x": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "xor",
              "mappings": {
                "n": 1
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "n": 1
          },
          "expectedError": "Cannot create conjunction based on {\n  \"type\": \"xor\",\n  \"mappings\": {\n    \"n\": 1\n  }\n}"
        }
      ]
    },
    {
      "name": "null equals null, missing equals undefined only",
      "rules": {
        "x": [
          {
            "name": "required",
            "shouldValidate": {
              "type": "and",
              "mappings": {
                "n": null
              }
            }
          }
        ]
      },
      "cases": [
        {
          "input": {
            "n": null
          },
          "expectedError": "Cannot convert undefined or null to object"
        },
        {
          "input": {},
          "expectedError": "Cannot convert undefined or null to object"
        },
        {
          "input": {
            "n": 0
          },
          "expectedError": "Cannot convert undefined or null to object"
        }
      ]
    }
  ]
}
